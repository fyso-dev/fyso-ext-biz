# Local Fyso Biz for the contract tier (tests/contract/) and the local sweep (scripts/e2e-local/).
# The stack lives in fyso-business (infra/local, branch feat/local-docker-stack):
#   BIZ_LOCAL_PG_PORT=5467 node infra/local/orquestador.mjs up --background
#   node infra/local/orquestador.mjs down            # --keep-credentials while iterating
# Copy this file to .env.local-biz (ignored by git) or export the variables. Never commit credentials.env.

# --- contract tier: `mise run contract` / `npm run test:contract` (skipped when BIZ_CONTRACT_URL is unset) ---
BIZ_CONTRACT_URL=http://localhost:8787
BIZ_CONTRACT_ORGANIZATION=local-org
# The stack's credentials.env (personas propietario, admin2, miembro, sinacceso, congelable; fake-fyso URL and admin token).
BIZ_CONTRACT_CREDENTIALS=<path to fyso-business>/.data/local/credentials.env
# fake-fyso, for the freeze scenarios. Both default to the FAKE_FYSO_URL / FAKE_FYSO_ADMIN_TOKEN of credentials.env.
BIZ_CONTRACT_FAKE_FYSO_URL=http://localhost:3015
# BIZ_CONTRACT_FAKE_FYSO_ADMIN_TOKEN=

# --- the framework and the extension, pointed at the local Biz ---
FYSO_DIST_BIZ_URL=http://localhost:8787
FYSO_DIST_BIZ_ORGANIZATION=local-org

# --- local sweep (scripts/e2e-local/run.sh) ---
# FYSO_BUSINESS_ROOT=<path to fyso-business>
# E2E_FRAMEWORK_REPO=<path to agentic-framework>
