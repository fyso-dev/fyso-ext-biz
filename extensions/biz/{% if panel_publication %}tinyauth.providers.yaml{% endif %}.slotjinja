{% if panel_publication %}
fyso-biz:
  name: Fyso Biz
  clientId: {{ biz_sso_client_id | to_json }}
  clientSecret: "${FYSO_AUTH_BIZ_SSO_SECRET}"
  authUrl: {{ (biz_url ~ '/oauth/authorize') | to_json }}
  tokenUrl: {{ (biz_url ~ '/oauth/token') | to_json }}
  userinfoUrl: {{ (biz_url ~ '/oauth/userinfo') | to_json }}
  scopes: [perfil]
  whitelist: [{{ biz_sso_email | to_json }}]
  claims:
    username: email
    name: nombre
{% endif %}
