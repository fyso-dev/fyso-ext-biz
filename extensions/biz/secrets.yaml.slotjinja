- name: BOT_FYSO_BIZ_TOKEN
  description: {es: Token personal de Fyso Biz, en: Fyso Biz personal token}
  required: false
{% if panel_publication %}
- name: FYSO_PUBLICATION_TOKEN
  description:
    en: Fyso Biz OAuth access token with perfil scope
    es: Token OAuth de Fyso Biz con alcance perfil
  required: false
- name: FYSO_AUTH_BIZ_SSO_SECRET
  description:
    en: Client secret for Tinyauth single sign-on through Fyso Biz
    es: Secreto del cliente de inicio de sesión único de Tinyauth con Fyso Biz
  required: false
{% endif %}
